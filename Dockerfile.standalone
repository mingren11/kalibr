# Kalibr standalone build (no ROS)
#
# Build (from catkin_ws):
#   docker build -f src/kalibr/Dockerfile.standalone -t kalibr src/kalibr
#
# Manual build inside container (e.g. dev Docker with mixed OpenCV):
#   cd /catkin_ws/src/kalibr && mkdir -p build_standalone && cd build_standalone
#   cmake .. -DBUILD_TESTING=OFF -DOpenCV_DIR=/usr/lib/x86_64-linux-gnu/cmake/opencv4
#   make -j$(nproc)
#   (Use -DOpenCV_DIR to force system OpenCV if libopencv_highgui.so.409 error occurs)
#
# Run (mount workspace with dataset/, imu.yaml, camchain, etc.):
#   docker run -it -v /path/to/catkin_ws:/catkin_ws kalibr
#   docker run -it -v /path/to/catkin_ws:/catkin_ws kalibr kalibr_calibrate_cameras --folder /catkin_ws/dataset --topics cam0 cam1 ...

FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive

# Dependencies (from README_standalone.md)
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake build-essential \
    python3 python3-dev python3-pip \
    libboost-all-dev \
    libeigen3-dev \
    libsuitesparse-dev \
    libtbb-dev \
    libopencv-dev \
    libv4l-dev \
    python3-numpy python3-scipy python3-matplotlib \
    python3-wxgtk4.0 \
    python3-yaml \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# # Kalibr in /opt (not overwritten by volume mount)
# ENV KALIBR_ROOT=/opt/kalibr
# COPY . $KALIBR_ROOT

# # Build standalone (force system OpenCV to avoid libopencv_highgui.so.409 mismatch)
# RUN mkdir -p $KALIBR_ROOT/build_standalone \
#     && cd $KALIBR_ROOT/build_standalone \
#     && cmake .. -DBUILD_TESTING=OFF -DOpenCV_DIR=/usr/lib/x86_64-linux-gnu/cmake/opencv4 \
#     && make -j$(nproc)

# # Matplotlib backend for headless/Docker (no display)
# ENV MPLBACKEND=Agg

# # Default working dir for user data
# WORKDIR /catkin_ws

# # Entrypoint: source kalibr env, run CMD or drop into shell
# ENTRYPOINT ["/bin/bash", "-c", "source $KALIBR_ROOT/setup_kalibr.sh && exec \"${@:-/bin/bash}\"", "--"]
